# HTTP
PORT=3000

# API path segment (no leading/trailing slashes). Full base URL path = /<API_BASE_PATH>
API_BASE_PATH=api/v1

# PostgreSQL — prefer DATABASE_URL; otherwise use discrete vars below
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexor_life
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=nexor_life

# ORM — NEVER set to true outside throwaway local DB
# TYPEORM_SYNCHRONIZE=true

# Optional: log SQL (dev only)
# DB_LOGGING=true

# Auth — use a strong secret in production (32+ characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# CORS — comma-separated origins or * for dev only
FRONTEND_ORIGIN=http://localhost:3001

# OpenAPI — in production keep false unless protected; dev defaults to on when NODE_ENV is not production
SWAGGER_ENABLED=true

# NODE_ENV=production

# Optional seed (see package.json db:seed)
# SEED_ADMIN_PASSWORD=ChangeMe123!
